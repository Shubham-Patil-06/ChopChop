DEBUG=False
SECRET_KEY=your-secret-key-here

# Render sets the hostname automatically — add it here
ALLOWED_HOSTS=chopchop-backend.onrender.com,localhost

# Render injects DATABASE_URL automatically when you add a PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — your Cloudflare Pages URL (and custom domain if any)
CORS_ALLOWED_ORIGINS=https://your-project.pages.dev,https://yourcustomdomain.com

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email (Gmail SMTP with an App Password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Optional: used by render-build.sh for first-deploy superuser creation
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=strongpassword
